<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             servlet4-schemas/web-app_4_0.xsd"
         version="4.0">
    <servlet>
        <servlet-name>RoomsServlet</servlet-name>
        <servlet-class>ua.edu.nupp.kpp.server.RoomsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RoomsServlet</servlet-name>
        <url-pattern>/rooms</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>EquipmentServlet</servlet-name>
        <servlet-class>ua.edu.nupp.kpp.server.EquipmentServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>EquipmentServlet</servlet-name>
        <url-pattern>/equipment</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>SpecialistsServlet</servlet-name>
        <servlet-class>ua.edu.nupp.kpp.server.SpecialistsServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>SpecialistsServlet</servlet-name>
        <url-pattern>/specialists</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>RequestsServlet</servlet-name>
        <servlet-class>ua.edu.nupp.kpp.server.RequestsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RequestsServlet</servlet-name>
        <url-pattern>/requests</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ExecutionRecordsServlet</servlet-name>
        <servlet-class>ua.edu.nupp.kpp.server.ExecutionRecordsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ExecutionRecordsServlet</servlet-name>
        <url-pattern>/executionrecords</url-pattern>
    </servlet-mapping>
</web-app>
